{
  "realm": "fhir",
  "enabled": true,
  "sslRequired": "none",
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 86400,
  "accessTokenLifespan": 3600,
  "clientSessionIdleTimeout": 3600,
  "clientSessionMaxLifespan": 86400,
  "clientScopes": [
    { "name": "openid", "protocol": "openid-connect" },         
    { "name": "profile", "protocol": "openid-connect" },       
    { "name": "email", "protocol": "openid-connect" },
    { "name": "role_list", "protocol": "openid-connect" },
    { "name": "launch", "protocol": "openid-connect" },
    { "name": "patient/Patient.read", "protocol": "openid-connect" },
    { "name": "patient/Observation.read", "protocol": "openid-connect" },
    { "name": "patient/Condition.read", "protocol": "openid-connect" },
    { "name": "fhirUser", "protocol": "openid-connect" }
  ],
  "clients": [
    {
      "clientId": "app",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "unused",
      "redirectUris": [
        "*"
      ],
      "webOrigins": [ "*" ],
      "publicClient": true,
      "defaultClientScopes": [
        "role_list",
        "profile",
        "email",
        "openid",
        "launch",
        "patient/Patient.read"
      ],
      "optionalClientScopes": [
        "patient/Observation.read",
        "patient/Condition.read",
        "fhirUser"
      ]
    }
  ],
  "users": [
    {
      "username": "fhir-admin",
      "enabled": true,
      "email": "fhir-admin@local.test",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "pa55word", "temporary": false }
      ],
      "realmRoles": [ "admin" ]
    }
  ]
}
